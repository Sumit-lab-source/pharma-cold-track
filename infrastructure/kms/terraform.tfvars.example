# Terraform variables for Pharma Cold Track KMS
# Copy this file to terraform.tfvars and fill in your values

# AWS Configuration
aws_region      = "us-east-1"
secondary_region = "us-west-2"
account_id      = "123456789012"  # Replace with your AWS Account ID

# Environment
environment = "prod"

# Optional: Custom key descriptions
# primary_key_description = "Production Pharma Cold Track Primary Encryption Key"